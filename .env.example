OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: override the parsing model (default: x-ai/grok-4.5)
# Any OpenRouter model supporting structured outputs will work.
# OPENROUTER_MODEL=x-ai/grok-4.5

# Optional: your deployed URL, sent as HTTP-Referer for OpenRouter attribution
# OPENROUTER_SITE_URL=https://gram-reaper.fly.dev

# ─── Auth (required) ──────────────────────────────────────────────
# Google OAuth *client ID* (public, no secret needed for the ID-token flow).
# Create at console.cloud.google.com -> Credentials -> OAuth client ID -> Web
# Authorized JavaScript origins: http://localhost:5173 and your deployed URL
GOOGLE_CLIENT_ID=
# Comma-separated allowlist. Only these Google accounts can sign in.
ALLOWED_EMAILS=
# Signs the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

DATABASE_PATH=./data/gramreaper.db
NODE_ENV=development
PORT=3001
