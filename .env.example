OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: override the parsing model (default: x-ai/grok-4.5)
# Any OpenRouter model supporting structured outputs will work.
# OPENROUTER_MODEL=x-ai/grok-4.5

# Optional: your deployed URL, sent as HTTP-Referer for OpenRouter attribution
# OPENROUTER_SITE_URL=https://gram-reaper.fly.dev

# ─── Auth (required) ──────────────────────────────────────────────
# Access code required to open the app, re-entered every time you open it.
# Never commit the real value — this repo is public.
APP_ACCESS_CODE=

DATABASE_PATH=./data/gramreaper.db
NODE_ENV=development
PORT=3001
